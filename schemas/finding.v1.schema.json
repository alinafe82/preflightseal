{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflightseal.dev/schemas/finding.v1.schema.json",
  "title": "PreflightSeal Finding v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "fingerprint",
    "title",
    "category",
    "decision",
    "severity",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": { "const": "preflightseal.finding.v1" },
    "id": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^pfs1:sha256:[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ALLOW", "WARN", "BLOCK", "INCONCLUSIVE"] },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "path": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string" },
    "providerId": { "type": "string", "minLength": 1 },
    "operationIdentity": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
