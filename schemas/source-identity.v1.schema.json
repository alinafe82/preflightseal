{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflightseal.dev/schemas/source-identity.v1.schema.json",
  "title": "PreflightSeal Source Identity v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "originalInput",
    "canonical",
    "canonicalIdentity",
    "resolvedRevision",
    "contentDigest",
    "retrievedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "preflightseal.source.v1" },
    "kind": { "enum": ["local", "github"] },
    "originalInput": { "type": "string", "minLength": 1 },
    "canonical": { "type": "string", "minLength": 1 },
    "canonicalIdentity": { "type": "string", "minLength": 1 },
    "requestedRef": { "type": "string" },
    "resolvedRevision": { "type": "string", "minLength": 1 },
    "archiveSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "contentDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "cacheKey": { "type": "string", "pattern": "^sha256/[a-fA-F0-9]{64}$" },
    "immutableLocator": { "type": "string", "pattern": "^preflightseal-cache:sha256/[a-fA-F0-9]{64}$" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
